# Copy to .env; loaded automatically at startup. Process variables take precedence.
# Public address used in password-reset links.
APP_BASE_URL=http://127.0.0.1:8000

# SMTP is required for email verification and password reset.
# Explicit local demo signup needs no SMTP: development + academic + localhost only.
APP_ENV=development
WAITLIST_MODE=academic
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_RESET_TTL_SECONDS=1800
AUTH_VERIFY_TTL_SECONDS=86400

# Gmail SMTP (STARTTLS). Use a Google app password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-address@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# US5: maximum ECTS before an advisor overload approval is required.
REGISTRATION_CREDIT_LIMIT=30
# Optional university gateway for Push and fallback Email seat events.
# Direct SMTP and Telegram do not require this gateway.
# Keep empty until the gateway is available. Pending events are retried.
UNIVERSITY_NOTIFICATION_URL=
UNIVERSITY_NOTIFICATION_TOKEN=

# Create a bot with @BotFather. Keep its token private.
TELEGRAM_BOT_TOKEN=
