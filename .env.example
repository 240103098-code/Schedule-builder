# Public address used in password-reset links.
APP_BASE_URL=http://127.0.0.1:8000

# Use "production" in production. Without SMTP, development mode exposes the
# reset step in the UI so the flow can still be tested locally.
APP_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_RESET_TTL_SECONDS=1800

# SMTP example (STARTTLS on port 587).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
